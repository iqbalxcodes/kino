<file path="apps/server/src/controllers/auth.controller.js">
const bcrypt = require("bcryptjs");
const jwt = require("jsonwebtoken");
const User = require("../models/User");
const { jwtSecret } = require("../config");
const { HttpError } = require("../middleware/errorHandler");

const EMAIL_RE = /^\S+@\S+\.\S+$/;
const clean = (v) => (typeof v === "string" ? v.trim() : "");

exports.register = async (req, res) => {
    const name = clean(req.body?.name);
    const email = clean(req.body?.email).toLowerCase();
    const password = req.body?.password;

    const details = {};
    if (name.length < 2 || name.length > 50) details.name = "Nama harus 2-50 karakter";
    if (!EMAIL_RE.test(email)) details.email = "Email tidak valid";
    if (typeof password !== "string" || password.length < 6 || password.length > 72) {
        details.password = "Password harus 6-72 karakter";
    }
    if (Object.keys(details).length) throw new HttpError(400, "Data tidak valid", details);

    try {
        await User.create({ name, email, passwordHash: await bcrypt.hash(password, 10) });
    } catch (err) {
        if (err.code === 11000) throw new HttpError(409, "Email sudah terdaftar", { email: "Email sudah terdaftar" });
        throw err;
    }
    res.status(201).json({ message: "Registrasi berhasil" });
};

exports.login = async (req, res) => {
    const email = clean(req.body?.email).toLowerCase();
    const password = req.body?.password;

    const user = email && typeof password === "string" && (await User.findOne({ email }));
    if (!user || !(await bcrypt.compare(password, user.passwordHash))) {
        throw new HttpError(401, "Email atau password salah");
    }

    const token = jwt.sign({ name: user.name }, jwtSecret, { subject: String(user._id), expiresIn: "7d" });
    res.json({ token, user: { id: user._id, name: user.name, email: user.email } });
};
</file>

<file path="apps/server/src/controllers/film.controller.js">
const mongoose = require("mongoose");
const Film = require("../models/Film");
const { HttpError } = require("../middleware/errorHandler");

const LIST_FIELDS = "title ratingOverall ratingCount categories year posterUrl backdropUrl youtubeUrl";

async function findFilm(id, select) {
    const query = mongoose.isValidObjectId(id) ? Film.findById(id) : null;
    const film = query && (await (select ? query.select(select) : query));
    if (!film) throw new HttpError(404, "Film tidak ditemukan");
    return film;
}

// GET /api/films?sort=popular  (tanpa limit = semua film; ?limit=N kalau perlu)
exports.list = async (req, res) => {
    const sort = req.query.sort === "popular" ? { ratingCount: -1, ratingOverall: -1 } : { title: 1 };
    // ponytail: tanpa paginasi, limit(0) = semua. Tambah paginasi kalau film sudah ratusan.
    res.json(await Film.find().select(LIST_FIELDS).sort(sort).limit(Number(req.query.limit) || 0));
};

// GET /api/films/:id  (tanpa daftar rating)
exports.detail = async (req, res) => {
    res.json(await findFilm(req.params.id, "-ratings -__v"));
};

// GET /api/films/:id/ratings
exports.ratings = async (req, res) => {
    const film = await findFilm(req.params.id, "ratings ratingOverall ratingCount");
    res.json({ ratingOverall: film.ratingOverall, ratingCount: film.ratingCount, ratings: film.ratings });
};

// POST /api/films/:id/ratings  (login) body: { rating: 1-10, comments? }
exports.rate = async (req, res) => {
    const rating = req.body?.rating;
    const comments = req.body?.comments ?? "";

    const details = {};
    if (!Number.isInteger(rating) || rating < 1 || rating > 10) details.rating = "Rating harus angka bulat 1-10";
    if (typeof comments !== "string" || comments.length > 1000) details.comments = "Komentar maksimal 1000 karakter";
    if (Object.keys(details).length) throw new HttpError(400, "Data tidak valid", details);

    const film = await findFilm(req.params.id);
    film.applyRating(req.user, rating, comments.trim());
    // ponytail: read-modify-write, dua user rating bersamaan bisa saling timpa. $inc/pipeline update kalau trafik naik.
    await film.save();

    res.status(201).json({ ratingOverall: film.ratingOverall, ratingCount: film.ratingCount, ratings: film.ratings });
};
</file>

<file path="apps/server/src/middleware/auth.js">
const jwt = require("jsonwebtoken");
const { jwtSecret } = require("../config");
const { HttpError } = require("./errorHandler");

module.exports = function requireAuth(req, res, next) {
    const header = req.headers.authorization || "";
    try {
        const payload = jwt.verify(header.replace(/^Bearer /, ""), jwtSecret);
        req.user = { id: payload.sub, name: payload.name };
        next();
    } catch {
        next(new HttpError(401, "Silakan login dulu"));
    }
};
</file>

<file path="apps/server/src/middleware/errorHandler.js">
class HttpError extends Error {
    constructor(status, message, details) {
        super(message);
        this.status = status;
        this.details = details;
    }
}

function notFound(req, res) {
    res.status(404).json({ message: "Endpoint tidak ditemukan" });
}

function errorHandler(err, req, res, next) {
    const status = err.status || 500;
    if (status === 500) console.error(err);
    res.status(status).json({
        message: status === 500 ? "Terjadi kesalahan pada server" : err.message,
        details: err.details,
    });
}

module.exports = { HttpError, notFound, errorHandler };
</file>

<file path="apps/server/src/models/Film.js">
const mongoose = require("mongoose");

const ratingSchema = new mongoose.Schema(
    {
        userId: { type: mongoose.Schema.Types.ObjectId, ref: "User", required: true },
        username: { type: String, required: true },
        rating: { type: Number, required: true, min: 1, max: 10 },
        comments: { type: String, default: "" },
    },
    { _id: false }
);

const filmSchema = new mongoose.Schema({
    title: { type: String, required: true },
    ratingOverall: { type: Number, default: 0 },
    ratingCount: { type: Number, default: 0 },
    ratings: [ratingSchema],
    categories: [String],
    year: Number,
    posterUrl: String,
    backdropUrl: String,
    youtubeUrl: String,
    synopsis: String,
});

filmSchema.methods.applyRating = function (user, rating, comments) {
    const old = this.ratings.find((r) => r.userId.equals(user.id));
    if (old) {
        this.ratingOverall += (rating - old.rating) / this.ratingCount;
        old.set({ rating, comments });
    } else {
        this.ratingOverall = (this.ratingOverall * this.ratingCount + rating) / (this.ratingCount + 1);
        this.ratingCount += 1;
        this.ratings.push({ userId: user.id, username: user.name, rating, comments });
    }
};

module.exports = mongoose.model("Film", filmSchema);
</file>

